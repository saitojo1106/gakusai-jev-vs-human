{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "security-checkpoint",
	"main": "./dist/index.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "GAME_DB",
			"database_name": "gakusai-jev",
			"database_id": "e583782d-bceb-433f-a034-c245026c58c7",
			"migrations_dir": "./migrations"
		}
	],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "security.saitoudayooooon-jo.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"JEV_MODEL": "typesafe-ai/jev",
		"JEV_TIMEOUT_MS": "3000",
		"JUDGE": "gateway"
	}
}
